--- alpha1-src/docker-compose.yml	2026-09-07 16:17:32.482495224 +0000
+++ alpha1-patch/docker-compose.yml	2026-09-07 16:23:40.754486801 +0000
@@ -122,13 +122,25 @@
       # somewhere else.
       SEARXNG_URL: ${SEARXNG_URL}
       EDGE_INTERNAL_KEY: ${EDGE_INTERNAL_KEY}
-      EDGE_RETENTION_DAYS: ${EDGE_RETENTION_DAYS}
+      # PATCH: 30 -> 400 days (~13 months, enough for a trailing-12-months
+      # comparison at any point in the year) -- set explicitly in Portainer's
+      # stack env vars; the :-400 here is just a compose-level fallback so an
+      # unset var lands on the new steady-state, matching edgeStore.js's own
+      # code-level default.
+      EDGE_RETENTION_DAYS: ${EDGE_RETENTION_DAYS:-400}
+      # Internal-only Chronos-2 sidecar backing GET /v1/edge/rpc-forecast and
+      # /v1/edge/rpc-anomaly -- see chronos-forecast service below. Only
+      # needs setting in Portainer if this is ever pointed somewhere else;
+      # the code default in edgeDataSource.js already matches this service
+      # name, same graceful-default pattern as SOL_RPC_URL etc. above.
+      CHRONOS_URL: http://chronos-forecast:8000
     volumes:
       - edge-data:/app/data
     depends_on:
       - sol-rpc-cache
       - puppeteer-render
       - searxng
+      - chronos-forecast
     healthcheck:
       test: ["CMD", "node", "-e", "fetch('http://localhost:4021/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
       interval: 30s
@@ -229,6 +241,30 @@
     environment:
       SEARXNG_BASE_URL: http://searxng:8080/
 
+  chronos-forecast:
+    # Internal-only sidecar wrapping amazon/chronos-2 (Apache-2.0, CPU-
+    # capable, 120M params) for GET /v1/edge/rpc-forecast and rpc-anomaly.
+    # Same isolation pattern as sol-rpc-cache/peaq-facilitator/puppeteer-
+    # render above: no ports published to the host, reachable from
+    # onchain-snapshot-api only by service name over the docker network.
+    # Model weights are baked into the image at build time (see
+    # chronos-forecast.Dockerfile) so this needs no outbound internet at
+    # runtime and starts in seconds, not minutes.
+    build:
+      context: .
+      dockerfile: chronos-forecast.Dockerfile
+    image: umbrel-onchain-snapshot-chronos-forecast:latest
+    container_name: onchain-snapshot-chronos-forecast
+    restart: unless-stopped
+    environment:
+      PORT: "8000"
+    healthcheck:
+      test: ["CMD", "python", "-c", "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:'+os.environ.get('PORT','8000')+'/health').status==200 else 1)"]
+      interval: 30s
+      timeout: 5s
+      retries: 3
+      start_period: 30s
+
   caddy:
